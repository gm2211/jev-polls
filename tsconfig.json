{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "outDir": "dist", "rootDir": "src", "declaration": true,
    "forceConsistentCasingInFileNames": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
